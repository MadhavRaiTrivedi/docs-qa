# Copy to .env and change the values. docker compose reads .env automatically.
POSTGRES_DB=docs_qa
POSTGRES_USER=docs_qa
POSTGRES_PASSWORD=change-me

# Keys the web UI and API clients send in the X-Api-Key header.
EDITOR_API_KEY=change-me-editor-key
READER_API_KEY=change-me-reader-key

# Needed to embed documents and questions and to generate answers.
# Without it the API starts and accepts uploads, which are ingested once the key is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
